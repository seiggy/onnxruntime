<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone smoke test / sample that CONSUMES the NuGet packages (managed + the
    locally built Microsoft.ML.OnnxRuntime.Gpu.Linux arm64 CUDA package) exactly as a
    customer app would. Run this on the Jetson Orin to validate CUDA end-to-end.

    Unlike csharp/test/Microsoft.ML.OnnxRuntime.Tests.NetCoreApp (which builds against
    the in-tree native binaries), this project resolves the native library through the
    package's runtimes/linux-arm64/native/ payload via NuGet RID resolution.

    Usage on the Orin (after building/packing into ../out):
      dotnet run -c Release -r linux-arm64
      dotnet run -c Release -r linux-arm64 -- --cpu           # force CPU fallback
      dotnet run -c Release -r linux-arm64 -- path/to/model.onnx
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Microsoft.ML.OnnxRuntime.Jetson.Sample</RootNamespace>
    <AssemblyName>OrtJetsonCudaSample</AssemblyName>

    <!-- Jetson Orin is linux-arm64. Setting the RID makes the build copy the native
         runtimes/linux-arm64/native/*.so assets from the package to the output dir. -->
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <OnnxRuntimeRoot>$(MSBuildProjectDirectory)\..\..\..\..</OnnxRuntimeRoot>

    <!-- Override with -p:OrtVersion=1.28.0 to match your built packages. -->
    <OrtVersion Condition="'$(OrtVersion)' == ''">1.28.0</OrtVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(OrtVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="$(OrtVersion)" />
  </ItemGroup>

  <!-- Ship a tiny model next to the app so it works with no arguments. -->
  <ItemGroup>
    <None Include="$(OnnxRuntimeRoot)\csharp\testdata\mul_1.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>mul_1.onnx</Link>
    </None>
  </ItemGroup>

</Project>
